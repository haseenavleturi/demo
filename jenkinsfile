pipeline {
    agent any

    environment {
        image_name = "hello"
    }
    stages {
        stage("git-checkout") {
            steps {
                checkout scm
            }
        }
        stage("image-build") {
            steps {
                  bat 'docker build -t YOUR_DOCKERHUB_USERNAME/hello:%BUILD_NUMBER% .'
    }
            }
        }
        stage('docker login') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'docker_cred',
                usernameVariable: 'DOCKER_USERNAME',
                passwordVariable: 'DOCKER_PASSWORD'
            )
        ]) {
            bat 'echo %DOCKER_PASSWORD%| docker login -u %DOCKER_USERNAME% --password-stdin'
        }
    }
}
stage("docker push") {
            steps {
                bat 'docker push YOUR_DOCKERHUB_USERNAME/hello:%BUILD_NUMBER%'
            }
        }
    }

